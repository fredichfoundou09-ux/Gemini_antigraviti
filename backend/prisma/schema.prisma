datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// A. UTILISATEURS / SÉCURITÉ
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(100)
  email        String?  @db.VarChar(100)
  phone        String?  @db.VarChar(30)
  role         String   @db.VarChar(30) // superadmin, admin, teacher, student
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz

  // Relations
  student      Student?
  teacher      Teacher?
  auditLogs    AuditLog[]
  sentMessages Message[] @relation("SenderRelation")
  memberships  ConversationMember[]
  notifications Notification[]

  // Finance & pédagogie (traçabilité de création)
  createdInvoices Invoice[] @relation("InvoiceCreator")
  createdPayments Payment[] @relation("PaymentCreator")
  createdGrades   Grade[]   @relation("GradeCreator")
  createdCerts    Certificate[] @relation("CertificateCreator")
  validatedHours  TeacherHour[] @relation("ValidatorRelation")
  paidTeacherPayments TeacherPayment[] @relation("TeacherPaymentCreator")

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100) // CREATE, UPDATE, DELETE, etc.
  entityType  String   @map("entity_type") @db.VarChar(50) // Student, Payment, etc.
  entityId    String?  @map("entity_id") @db.Uuid
  description String   @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ==========================================
// B. FORMATIONS & MODULES
// ==========================================

model Formation {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50) // informatique, industriel
  name        String   @db.VarChar(150)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  modules     Module[]
  students    Student[]
  groups      StudentGroup[]
  registrations PreRegistration[]
  certificates Certificate[]

  @@map("formations")
}

model Module {
  id           String   @id @default(uuid()) @db.Uuid
  formationId  String   @map("formation_id") @db.Uuid
  numero       Int      @db.Integer
  titre        String   @db.VarChar(150)
  icon         String?  @db.VarChar(50)
  description  String?  @db.Text
  duree        String?  @db.VarChar(50)
  supports     String?  @db.Text
  infosSupp    String?  @map("infos_supp") @db.Text
  imageUrl     String?  @map("image_url") @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  formation    Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
  students     StudentModule[]
  teachers     TeacherModule[]
  schedule     Schedule[]
  attendance   Attendance[]
  courses      Course[]
  submissions  Submission[]
  tests        Test[]
  grades       Grade[]
  rates        TeacherModuleRate[]
  certModules  CertificateModule[]
  regModules   RegistrationModule[]

  @@map("modules")
}

model Chapter {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  titre     String   @db.VarChar(150)
  contenu   String?  @db.Text
  ordre     Int      @db.Integer
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  tests     Test[]

  @@map("chapters")
}

// ==========================================
// C. APPRENANTS
// ==========================================

model Student {
  id              String   @id @db.VarChar(50) // SN-YYYY-XXXXX
  userId          String?  @unique @map("user_id") @db.Uuid
  formationId     String   @map("formation_id") @db.Uuid
  groupId         String?  @map("group_id") @db.Uuid
  nom             String   @db.VarChar(100)
  prenom          String   @db.VarChar(100)
  dateNaissance   DateTime? @map("date_naissance") @db.Date
  sexe            String?  @db.VarChar(10)
  telephone       String?  @db.VarChar(30)
  whatsapp        String?  @db.VarChar(30)
  email           String?  @db.VarChar(100)
  adresse         String?  @db.Text
  niveau          String?  @db.VarChar(100)
  photoUrl        String?  @map("photo_url") @db.Text
  dateInscription DateTime @default(now()) @map("date_inscription") @db.Date
  statut          String   @default("actif") @db.VarChar(20) // actif, inactif
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  formation       Formation    @relation(fields: [formationId], references: [id], onDelete: Restrict)
  group           StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  modules         StudentModule[]
  attendance      Attendance[]
  submissions     Submission[]
  testResults     TestResult[]
  invoices        Invoice[]
  payments        Payment[]
  certificates    Certificate[]
  scholarship     Scholarship?
  courseTargets   CourseTarget[]
  scheduleTargets ScheduleTarget[]

  @@map("students")
}

model StudentModule {
  studentId      String   @map("student_id") @db.VarChar(50)
  moduleId       String   @map("module_id") @db.Uuid
  dateInscription DateTime @default(now()) @map("date_inscription") @db.Date
  active         Boolean  @default(true)

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([studentId, moduleId])
  @@map("student_modules")
}

model StudentGroup {
  id          String   @id @default(uuid()) @db.Uuid
  formationId String   @map("formation_id") @db.Uuid
  nom         String   @db.VarChar(100) // ex: "Groupe A"
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  students    Student[]
  courses     Course[]
  schedule    Schedule[]

  @@map("student_groups")
}

model PreRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  formationId String   @map("formation_id") @db.Uuid
  nom         String   @db.VarChar(100)
  prenom      String   @db.VarChar(100)
  telephone   String   @db.VarChar(30)
  whatsapp    String   @db.VarChar(30)
  email       String?  @db.VarChar(100)
  niveau      String?  @db.VarChar(100)
  date        DateTime @default(now()) @db.Date
  statut      String   @default("en_attente") @db.VarChar(20) // en_attente, confirmee, refusee
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  modules     RegistrationModule[]

  @@map("registrations")
}

model RegistrationModule {
  registrationId String @map("registration_id") @db.Uuid
  moduleId       String @map("module_id") @db.Uuid

  registration   PreRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  module         Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([registrationId, moduleId])
  @@map("registration_modules")
}

// ==========================================
// D. ENSEIGNANTS
// ==========================================

model Teacher {
  id            String   @id @db.VarChar(50) // ENS-XXX
  userId        String?  @unique @map("user_id") @db.Uuid
  nom           String   @db.VarChar(100)
  prenom        String   @db.VarChar(100)
  specialite    String   @db.VarChar(150)
  email         String   @db.VarChar(100)
  phone         String   @db.VarChar(30)
  photoUrl      String?  @map("photo_url") @db.Text
  infosPro      String?  @map("infos_pro") @db.Text
  diplomes      String?  @db.Text
  typeContrat   String?  @map("type_contrat") @db.VarChar(50) // CDI, Prestation, Vacataire
  tarifHoraire  Decimal  @default(0.00) @map("tarif_horaire") @db.Decimal(12, 2)
  heuresPrevues Decimal  @default(0.00) @map("heures_prevues") @db.Decimal(8, 2)
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  modules       TeacherModule[]
  rates         TeacherModuleRate[]
  hours         TeacherHour[]
  payments      TeacherPayment[]
  courses       Course[]
  schedule      Schedule[]
  attendance    Attendance[]
  submissions   Submission[]
  tests         Test[]

  @@map("teachers")
}

model TeacherModule {
  teacherId String @map("teacher_id") @db.VarChar(50)
  moduleId  String @map("module_id") @db.Uuid

  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([teacherId, moduleId])
  @@map("teacher_modules")
}

model TeacherModuleRate {
  teacherId    String  @map("teacher_id") @db.VarChar(50)
  moduleId     String  @map("module_id") @db.Uuid
  tarifHoraire Decimal @map("tarif_horaire") @db.Decimal(12, 2)

  teacher      Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  module       Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([teacherId, moduleId])
  @@map("teacher_module_rates")
}

model TeacherHour {
  id             String   @id @default(uuid()) @db.Uuid
  scheduleId     String?  @map("schedule_id") @db.Uuid
  teacherId      String   @map("teacher_id") @db.VarChar(50)
  moduleId       String   @map("module_id") @db.Uuid
  date           DateTime @db.Date
  heureDebut     String   @map("heure_debut") @db.VarChar(10)
  heureFin       String   @map("heure_fin") @db.VarChar(10)
  heures         Decimal  @db.Decimal(6, 2)
  tarifApplique  Decimal  @map("tarif_applique") @db.Decimal(12, 2)
  montant        Decimal  @db.Decimal(12, 2)
  valide         Boolean  @default(false)
  validePar      String?  @map("valide_par") @db.Uuid
  dateValidation DateTime? @map("date_validation") @db.Timestamptz

  schedule       Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  module         Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  validator      User?     @relation("ValidatorRelation", fields: [validePar], references: [id], onDelete: SetNull)

  @@map("teacher_hours")
}

model TeacherPayment {
  id            String   @id @default(uuid()) @db.Uuid
  teacherId     String   @map("teacher_id") @db.VarChar(50)
  montant       Decimal  @db.Decimal(12, 2)
  date          DateTime @db.Date
  heure         String?  @db.VarChar(10)
  mode          String   @db.VarChar(50)
  reference     String?  @db.VarChar(100)
  observation   String?  @db.Text
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  creator       User?    @relation("TeacherPaymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("teacher_payments")
}

// ==========================================
// E. PÉDAGOGIE
// ==========================================

model Course {
  id              String   @id @default(uuid()) @db.Uuid
  titre           String   @db.VarChar(150)
  description     String?  @db.Text
  moduleId        String   @map("module_id") @db.Uuid
  teacherId       String   @map("teacher_id") @db.VarChar(50)
  type            String   @db.VarChar(30) // cours, document, devoir
  content         String?  @db.Text
  groupId         String?  @map("group_id") @db.Uuid
  audience        String   @default("module") @db.VarChar(30) // module, groupe, apprenants
  publie          Boolean  @default(true)
  datePublication DateTime @default(now()) @map("date_publication") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  module          Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  teacher         Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group           StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  files           CourseFile[]
  targets         CourseTarget[]
  submissions     Submission[]

  @@map("courses")
}

model CourseFile {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @map("stored_name") @db.VarChar(255)
  mime         String   @db.VarChar(100)
  size         Int      @db.Integer
  storageKey   String   @map("storage_key") @db.Text
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activities   FileActivity[]

  @@map("course_files")
}

model CourseTarget {
  courseId  String @map("course_id") @db.Uuid
  studentId String @map("student_id") @db.VarChar(50)

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
  @@map("course_targets")
}

model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  jour        String   @db.VarChar(20) // Lundi, Mardi...
  heureDebut  String   @map("heure_debut") @db.VarChar(10)
  heureFin    String   @map("heure_fin") @db.VarChar(10)
  date        DateTime? @db.Date
  moduleId    String   @map("module_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.VarChar(50)
  salle       String   @db.VarChar(100)
  formationId String   @map("formation_id") @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  teacher     Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group       StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendance  Attendance[]
  targets     ScheduleTarget[]
  teacherHours TeacherHour[]

  @@map("schedule")
}

model ScheduleTarget {
  scheduleId String @map("schedule_id") @db.Uuid
  studentId  String @map("student_id") @db.VarChar(50)

  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([scheduleId, studentId])
  @@map("schedule_targets")
}

model Attendance {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.VarChar(50)
  scheduleId String?  @map("schedule_id") @db.Uuid
  moduleId   String   @map("module_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.VarChar(50)
  date       DateTime @db.Date
  heure      String   @db.VarChar(10)
  salle      String   @db.VarChar(100)
  statut     String   @db.VarChar(20) // present, absent, retard
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleId, date])
  @@map("attendance")
}

model FileActivity {
  id           String   @id @default(uuid()) @db.Uuid
  courseFileId String   @map("course_file_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String   @db.VarChar(30) // ouvert, telecharge
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text

  file         CourseFile @relation(fields: [courseFileId], references: [id], onDelete: Cascade)

  @@map("file_activities")
}

model Submission {
  id             String   @id @default(uuid()) @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  moduleId       String   @map("module_id") @db.Uuid
  studentId      String   @map("student_id") @db.VarChar(50)
  teacherId      String   @map("teacher_id") @db.VarChar(50)
  texte          String?  @db.Text
  date           DateTime @default(now()) @map("date") @db.Timestamptz
  note           Decimal? @db.Decimal(5, 2)
  appreciation   String?  @db.Text
  valide         Boolean  @default(false)
  dateCorrection DateTime? @map("date_correction") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  files          SubmissionFile[]

  @@map("submissions")
}

model SubmissionFile {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  fileUrl      String @map("file_url") @db.Text
  fileName     String @map("file_name") @db.VarChar(255)
  mime         String @db.VarChar(100)
  size         Int    @db.Integer

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_files")
}

// ==========================================
// F. TESTS & ÉVALUATIONS
// ==========================================

model Test {
  id                 String   @id @default(uuid()) @db.Uuid
  titre              String   @db.VarChar(150)
  moduleId           String   @map("module_id") @db.Uuid
  chapitreId         String?  @map("chapitre_id") @db.Uuid
  teacherId          String   @map("teacher_id") @db.VarChar(50)
  date               DateTime @default(now()) @db.Timestamptz
  duree              Int      @db.Integer
  bareme             Decimal  @default(20.00) @db.Decimal(5, 2)
  dateDebut          DateTime? @map("date_debut") @db.Timestamptz
  dateFin            DateTime? @map("date_fin") @db.Timestamptz
  difficulte         String   @default("moyen") @db.VarChar(20) // facile, moyen, difficile
  tentatives         Int      @default(1) @db.Integer
  afficherCorrections Boolean  @default(true) @map("afficher_corrections")
  validationRequise  Boolean  @default(false) @map("validation_requise")

  module             Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  chapter            Chapter? @relation(fields: [chapitreId], references: [id], onDelete: SetNull)
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions          Question[]
  results            TestResult[]

  @@map("tests")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  testId       String   @map("test_id") @db.Uuid
  question     String   @db.Text
  type         String   @db.VarChar(20) // qcm, vf, courte
  bonneReponse String   @map("bonne_reponse") @db.Text
  points       Decimal  @db.Decimal(5, 2)
  explication  String?  @db.Text
  ordre        Int      @db.Integer

  test         Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  answers      TestAnswer[]

  @@map("questions")
}

model QuestionOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  optionText String @map("option_text") @db.Text
  ordre      Int    @db.Integer

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model TestResult {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @map("test_id") @db.Uuid
  studentId   String   @map("student_id") @db.VarChar(50)
  note        Decimal  @db.Decimal(5, 2)
  pourcentage Decimal  @db.Decimal(5, 2)
  date        DateTime @default(now()) @db.Timestamptz
  heure       String?  @db.VarChar(10)
  valide      Boolean  @default(true)
  statut      String   @db.VarChar(20) // reussi, echoue

  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     TestAnswer[]

  @@map("test_results")
}

model TestAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  resultId      String   @map("result_id") @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  reponse       String   @db.Text
  correct       Boolean  @default(false)
  pointsObtenus Decimal  @map("points_obtenus") @db.Decimal(5, 2)

  result        TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question      Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("test_answers")
}

// ==========================================
// G. CARNET DE NOTES
// ==========================================

model Grade {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.VarChar(50)
  moduleId     String   @map("module_id") @db.Uuid
  note         Decimal  @db.Decimal(5, 2)
  appreciation String   @db.Text
  date         DateTime @db.Date
  createdBy    String?  @map("created_by") @db.Uuid

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  creator      User?    @relation("GradeCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("grades")
}

// ==========================================
// H. FINANCES (APPRENANTS)
// ==========================================

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.VarChar(50)
  type      String   @db.VarChar(30) // inscription, formation
  libelle   String   @db.VarChar(150)
  montant   Decimal  @db.Decimal(12, 2)
  date      DateTime @db.Date
  dueDate   DateTime? @map("due_date") @db.Date
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  creator   User?    @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@map("invoices")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.VarChar(50)
  invoiceId     String?  @map("invoice_id") @db.Uuid
  type          String   @db.VarChar(30) // inscription, formation
  libelle       String   @db.VarChar(150)
  montant       Decimal  @db.Decimal(12, 2)
  date          DateTime @db.Date
  heure         String?  @db.VarChar(10)
  mode          String   @db.VarChar(50) // Espèces, Mobile Money...
  reference     String?  @unique @db.VarChar(100) // n° de reçu
  observation   String?  @db.Text
  createdBy     String?  @map("created_by") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creator       User?    @relation("PaymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("payments")
}

// ==========================================
// I. COMMUNICATION
// ==========================================

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  subject   String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadAt     DateTime @default(now()) @map("last_read_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SenderRelation", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // null pour les notifications globales
  title     String   @db.VarChar(150)
  body      String   @db.Text
  type      String   @db.VarChar(30) // paiement, test, certif, bourse, info...
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==========================================
// J. CERTIFICATION & BOURSES
// ==========================================

model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.VarChar(50)
  numero      String   @unique @db.VarChar(50)
  formationId String   @map("formation_id") @db.Uuid
  periode     String   @db.VarChar(100)
  resultat    String   @db.Text
  note        Decimal  @db.Decimal(5, 2)
  date        DateTime @db.Date
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Restrict)
  creator     User?    @relation("CertificateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  modules     CertificateModule[]

  @@map("certificates")
}

model CertificateModule {
  certificateId String @map("certificate_id") @db.Uuid
  moduleId      String @map("module_id") @db.Uuid

  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  module        Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([certificateId, moduleId])
  @@map("certificate_modules")
}

model Scholarship {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @map("student_id") @db.VarChar(50)
  statut    String   @db.VarChar(50) // en_attente, test_programme, test_effectue, admis, non_admis, bourse_attribuee
  date      DateTime @db.Date
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("scholarships")
}

// ==========================================
// K. CONTENU ENIA 2.0 (DYNAMIQUE)
// ==========================================

model EniaContent {
  id                   String   @id @default("singleton") @db.VarChar(50)
  visible              Boolean  @default(true)
  titre                String   @db.VarChar(150)
  sousTitre            String   @map("sous_titre") @db.VarChar(255)
  presentation         String   @db.Text
  bourseTitre          String   @map("bourse_titre") @db.VarChar(150)
  bourseIntro          String   @map("bourse_intro") @db.Text
  bourseConcretement   String   @map("bourse_concretement") @db.Text
  noteInscription      String   @map("note_inscription") @db.Text
  afficheUrl           String?  @map("affiche_url") @db.Text
  allowDownloadAffiche Boolean  @default(true) @map("allow_download_affiche")
  lienNom              String   @map("lien_nom") @db.VarChar(100)
  lienUrl              String   @map("lien_url") @db.VarChar(255)
  lienDescription      String   @map("lien_description") @db.Text
  lienActif            Boolean  @default(true) @map("lien_actif")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("enia_content")
}

model EniaAdvantage {
  id          String @id @default(uuid()) @db.Uuid
  titre       String @db.VarChar(150)
  description String @db.Text
  ordre       Int    @db.Integer

  @@map("enia_advantages")
}

model EniaFeeItem {
  id    String @id @default(uuid()) @db.Uuid
  label String @db.VarChar(150)
  value String @db.VarChar(100)
  ordre Int    @db.Integer

  @@map("enia_fee_items")
}

model EniaPieceGroup {
  id         String @id @default(uuid()) @db.Uuid
  titre      String @db.VarChar(150)
  pieces     String @db.Text // JSON ou texte brut séparé par \n
  fraisDepot String? @map("frais_depot") @db.VarChar(100)
  ordre      Int    @db.Integer

  @@map("enia_piece_groups")
}

model EniaPartner {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String   @db.VarChar(150)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.Text
  url         String?  @db.VarChar(255)
  telephone   String?  @db.VarChar(30)
  email       String?  @db.VarChar(100)
  actif       Boolean  @default(true)
  ordre       Int      @db.Integer

  @@map("enia_partners")
}
